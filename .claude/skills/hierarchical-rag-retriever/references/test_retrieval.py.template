def _make_chunk(doc_name: str, section: str, idx: int) -> Document:
    section_id = f"{doc_name}::{section.lower().replace(' ', '-')}"
    return Document(
        page_content=f"Chunk content {idx} from {section}",
        metadata={
            "parent_doc_name": doc_name,
            "parent_section_name": section,
            "parent_section_id": section_id,
            "chunk_id": f"{section_id}::chunk_{idx}",
        },
    )


def _make_fake_embeddings():
    mock = MagicMock()
    mock.embed_documents.return_value = [[0.1, 0.2, 0.3]] * 100
    mock.embed_query.return_value = [0.1, 0.2, 0.3]
    return mock


