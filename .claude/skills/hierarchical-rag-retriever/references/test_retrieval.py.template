# ---------------------------------------------------------------------------
# 3. Filter fallback behavior
# ---------------------------------------------------------------------------

class _FallbackRetriever:
    """Inline mock that implements the filter fallback chain for unit-testing."""

    def __init__(self, hits_by_filter_json: dict, sections: List[Document]):
        self._hits = hits_by_filter_json  # key: json.dumps(filter) or None
        self.section_index = {s.metadata["section_id"]: s for s in sections}
        self.top_k = 3

    def _search(self, query: str, filter_: Optional[dict]) -> List[Document]:
        key = json.dumps(filter_, sort_keys=True) if filter_ is not None else None
        return self._hits.get(key, [])

    def retrieve_with_ids(
        self, query: str, doc_name: Optional[str] = None, section_name: Optional[str] = None
    ):
        filter_: Optional[dict] = None
        if doc_name and section_name:
            filter_ = {
                "$and": [
                    {"parent_doc_name": {"$eq": doc_name}},
                    {"parent_section_name": {"$eq": section_name}},
                ]
            }
        elif doc_name:
            filter_ = {"parent_doc_name": {"$eq": doc_name}}

        hits = self._search(query, filter_)
        if not hits and doc_name and section_name:
            hits = self._search(query, {"parent_doc_name": {"$eq": doc_name}})
        if not hits:
            hits = self._search(query, None)

        chunk_ids = [h.metadata.get("chunk_id", "") for h in hits if h.metadata.get("chunk_id")]
        context = "[no relevant context retrieved]" if not hits else "[context]"
        return context, chunk_ids


class TestFilterFallback:
    def _doc_chunk(self, doc_name: str, section: str, chunk_id: str) -> Document:
        return Document(
            page_content=f"Content of {section}",
            metadata={
                "parent_doc_name": doc_name,
                "parent_section_name": section,
                "parent_section_id": f"{doc_name}::{section.lower()}",
                "chunk_id": chunk_id,
            },
        )

    def test_tight_filter_succeeds_no_fallback(self):
        """When (doc+section) filter finds hits, no fallback needed."""
        chunk = self._doc_chunk("sop.md", "PURPOSE", "sop.md::purpose::chunk_0")
        tight_key = json.dumps(
            {"$and": [
                {"parent_doc_name": {"$eq": "sop.md"}},
                {"parent_section_name": {"$eq": "PURPOSE"}},
            ]},
            sort_keys=True,
        )
        retriever = _FallbackRetriever({tight_key: [chunk]}, _make_heading_sections())
        _, chunk_ids = retriever.retrieve_with_ids("query", doc_name="sop.md", section_name="PURPOSE")
        assert chunk_ids == ["sop.md::purpose::chunk_0"]

    def test_fallback_to_doc_only_when_section_misses(self):
        """When (doc+section) returns empty, falls back to doc-only filter."""
        chunk = self._doc_chunk("sop.md", "PURPOSE", "sop.md::purpose::chunk_0")
        doc_key = json.dumps({"parent_doc_name": {"$eq": "sop.md"}}, sort_keys=True)
        retriever = _FallbackRetriever({doc_key: [chunk]}, _make_heading_sections())
        _, chunk_ids = retriever.retrieve_with_ids("query", doc_name="sop.md", section_name="NONEXISTENT")
        assert chunk_ids, "Expected fallback to doc-only filter to return hits"
        assert chunk_ids[0] == "sop.md::purpose::chunk_0"

    def test_fallback_to_unfiltered_when_doc_misses(self):
        """When both filtered searches fail, falls back to unfiltered."""
        chunk = self._doc_chunk("sop.md", "PURPOSE", "sop.md::purpose::chunk_0")
        retriever = _FallbackRetriever({None: [chunk]}, _make_heading_sections())
        _, chunk_ids = retriever.retrieve_with_ids("query", doc_name="nonexistent.md", section_name="X")
        assert chunk_ids, "Expected unfiltered fallback to return hits"

    def test_no_hits_returns_sentinel_string(self):
        """When all fallbacks return empty, context is the sentinel string."""
        retriever = _FallbackRetriever({}, _make_heading_sections())
        context, chunk_ids = retriever.retrieve_with_ids("query", doc_name="x.md", section_name="Y")
        assert context == "[no relevant context retrieved]"
        assert chunk_ids == []

    def test_unfiltered_call_passes_none_filter(self):
        """retrieve_with_ids with no doc_name/section_name calls _search with None filter."""
        chunk = self._doc_chunk("sop.md", "PURPOSE", "sop.md::purpose::chunk_0")
        retriever = _FallbackRetriever({None: [chunk]}, _make_heading_sections())
        _, chunk_ids = retriever.retrieve_with_ids("query")
        assert chunk_ids, "Expected unfiltered retrieve to return hits"


