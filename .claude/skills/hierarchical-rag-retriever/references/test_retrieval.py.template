# 1. Section splitting metadata
# ---------------------------------------------------------------------------

class TestSectionMetadata:
    def test_heading_splitter_required_keys(self):
        sections = _make_heading_sections()
        assert sections, "Expected at least one section"
        for sec in sections:
            m = sec.metadata
            for key in ("doc_name", "section_name", "section_id"):
                assert key in m, f"Missing {key!r} on section metadata: {m}"

    def test_heading_splitter_section_id_format(self):
        sections = _make_heading_sections()
        for sec in sections:
            sid = sec.metadata["section_id"]
            assert "::" in sid, f"section_id missing '::' separator: {sid!r}"
            doc_part, _ = sid.split("::", 1)
            assert doc_part == sec.metadata["doc_name"], (
                f"section_id prefix {doc_part!r} != doc_name {sec.metadata['doc_name']!r}"
            )

    def test_design_splitter_extra_keys_present(self):
        sections = _make_design_sections()
        assert sections, "Expected at least one section from design marker splitter"
        for sec in sections:
            m = sec.metadata
            for key in ("doc_name", "section_name", "section_id", "global_id", "project_id"):
                assert key in m, f"Missing {key!r} on design section metadata: {m}"

    def test_design_splitter_global_id_format(self):
        sections = _make_design_sections()
        for sec in sections:
            gid = sec.metadata["global_id"]
            assert re.match(r"GID-\d+", gid), f"Unexpected global_id format: {gid!r}"

    def test_design_splitter_project_id_format(self):
        sections = _make_design_sections()
        for sec in sections:
            pid = sec.metadata["project_id"]
            assert re.match(r"[A-Z0-9]+-[A-Z]+-\d+", pid), (
                f"Unexpected project_id format: {pid!r}"
            )


