"""
Corpus builder for a two-level hierarchical RAG retrieval substrate.

Generalizes multi-vec-retrieval/.../design_corpus.py so any corpus type
(docx, md, pdf) can be built with one shared function instead of copy-pasted
*_corpus.py files.

Usage:
    from your_pkg.corpus import CorpusConfig, load_or_build
    from your_pkg.chunker import split_by_design_marker

    design_cfg = CorpusConfig(
        name="design",
        collection_name="design_chunks",
        chroma_subdir="design",
        raw_dir=settings.design_raw_dir,
        parsed_dir=settings.design_parsed_dir,
        chunked_dir=settings.design_chunked_dir,
        splitter_fn=split_by_design_marker,
        extra_meta_keys=("global_id", "project_id"),
        raw_extension=".docx",
        top_k=5,
    )
    chunks, sections = load_or_build(design_cfg, embedding_model=settings.embedding_model)
"""
from __future__ import annotations

import json
import logging
from dataclasses import dataclass, field
from pathlib import Path
from typing import Callable, List, Optional, Tuple

from langchain_core.documents import Document
from langchain_experimental.text_splitter import SemanticChunker

logger = logging.getLogger(__name__)


# ---------------------------------------------------------------------------
# CorpusConfig
# ---------------------------------------------------------------------------

@dataclass
class CorpusConfig:
    """
    All corpus-specific parameters in one place.

    Attributes
    ----------
    name : str
        Short identifier used in log messages (e.g. "sop", "design").
    collection_name : str
        Chroma collection name. Must be unique per corpus to prevent cross-
        contamination within the same Chroma persist directory.
    chroma_subdir : str
        Sub-path appended to the base chroma dir:
            <chunked_dir>/chroma/<embedding_slug>/<chroma_subdir>/
        Use a non-empty value for every non-default corpus so Chroma dirs
        are namespaced per-corpus AND per-embedding-model.
    raw_dir : Path
        Directory that holds the source files (docx / pdf / md).
    parsed_dir : Path
        Directory where converted .md files are written. Must differ from raw_dir.
    chunked_dir : Path
        Directory where chunks.jsonl and sections.jsonl are persisted.
    splitter_fn : Callable[[str, str], List[Document]]
        Function(md_text, doc_name) -> List[section Documents].
        Use split_by_heading for ##-delimited markdown, or split_by_design_marker
        for GID/Project-ID marker docs. Custom corpora define their own.
    extra_meta_keys : Tuple[str, ...]
        Section metadata keys to propagate onto child chunks as parent_<key>.
        Empty tuple for corpora that only use doc_name / section_name / section_id.
        Example: ("global_id", "project_id") for design-marker corpora.
        Replaces the module-level _PROPAGATED_SECTION_META tuple in the live chunker.py.
    raw_extension : str
        File extension of source files: ".docx", ".pdf", or ".md".
        When ".md", _convert_all_raw is a no-op and files are read directly
        from parsed_dir (or raw_dir if they're the same).
    top_k : int
        Default retrieval depth for this corpus.
    """
    name: str                                          # TODO(rename): "sop", "design", ...
    collection_name: str                               # TODO(rename): "chunks", "design_chunks", ...
    chroma_subdir: str                                 # TODO(rename): "", "design", "guidance", ...
    raw_dir: Path
    parsed_dir: Path
    chunked_dir: Path
    splitter_fn: Callable[[str, str], List[Document]]
    extra_meta_keys: Tuple[str, ...] = field(default_factory=tuple)
    raw_extension: str = ".docx"                       # TODO(rename): ".docx", ".pdf", or ".md"
    top_k: int = 3


# ---------------------------------------------------------------------------
# JSONL persistence helpers
# ---------------------------------------------------------------------------

def _dump_jsonl(docs: List[Document], path: Path) -> None:
    with path.open("w", encoding="utf-8") as f:
        for d in docs:
            f.write(json.dumps({"page_content": d.page_content, "metadata": d.metadata}) + "\n")


def _load_jsonl(path: Path) -> List[Document]:
    out: List[Document] = []
    with path.open("r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            obj = json.loads(line)
            out.append(Document(page_content=obj["page_content"], metadata=obj["metadata"]))
    return out


def persist(chunks: List[Document], sections: List[Document], chunked_dir: Path) -> None:
    chunked_dir.mkdir(parents=True, exist_ok=True)
    _dump_jsonl(chunks, chunked_dir / "chunks.jsonl")
    _dump_jsonl(sections, chunked_dir / "sections.jsonl")


def load_persisted(chunked_dir: Path) -> Optional[Tuple[List[Document], List[Document]]]:
    c = chunked_dir / "chunks.jsonl"
    s = chunked_dir / "sections.jsonl"
    if not (c.exists() and s.exists()):
        return None
    return _load_jsonl(c), _load_jsonl(s)


