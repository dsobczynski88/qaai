    """Convert a single .docx to .md under parsed_dir. Idempotent: skips if .md exists."""
    md_path = parsed_dir / f"{docx_path.stem}.md"
    if md_path.exists():
        return md_path
    parsed_dir.mkdir(parents=True, exist_ok=True)
