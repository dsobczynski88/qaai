def _pdf_to_md(pdf_path: Path, parsed_dir: Path) -> Path:
    """Convert a single .pdf to .md under parsed_dir. Idempotent: skips if .md exists."""
    md_path = parsed_dir / f"{pdf_path.stem}.md"
    if md_path.exists():
        return md_path
    parsed_dir.mkdir(parents=True, exist_ok=True)
    # TODO(rename): swap in your pdf->md converter (e.g. PyMuPDF, pdfplumber).
    raise NotImplementedError(
        f"Wire a pdf->md converter for {pdf_path}."
    )


def _convert_all_raw(cfg: CorpusConfig, *, force: bool) -> List[Path]:
    """
    Convert every raw file to .md under parsed_dir.

    When raw_extension is ".md", treats files as already-parsed and returns
    .md paths directly from parsed_dir (no conversion needed).

    Returns the list of .md Paths to process downstream.
    """
    md_paths: List[Path] = []

    if cfg.raw_extension == ".md":
        src_dir = cfg.parsed_dir if cfg.parsed_dir.exists() else cfg.raw_dir
        if src_dir.exists():
            md_paths = sorted(src_dir.glob("*.md"))
        return md_paths

    if not cfg.raw_dir.exists():
        logger.warning(
            "[corpus=%r] raw_dir %s does not exist — no files to convert.",
            cfg.name, cfg.raw_dir,
        )
        return md_paths

    for raw_file in sorted(cfg.raw_dir.glob(f"*{cfg.raw_extension}")):
        md = cfg.parsed_dir / f"{raw_file.stem}.md"
        if force and md.exists():
            md.unlink()
        if cfg.raw_extension == ".docx":
            md_paths.append(_docx_to_md(raw_file, cfg.parsed_dir))
        elif cfg.raw_extension == ".pdf":
            md_paths.append(_pdf_to_md(raw_file, cfg.parsed_dir))
        else:
            raise ValueError(
                f"Unsupported raw_extension {cfg.raw_extension!r} for corpus {cfg.name!r}. "
                "Use '.docx', '.pdf', or '.md'."
            )

    # Also pick up .md files dropped directly into parsed_dir (e.g. for tests).
    if cfg.parsed_dir.exists():
        for md in sorted(cfg.parsed_dir.glob("*.md")):
            if md not in md_paths:
                md_paths.append(md)

    return md_paths


# ---------------------------------------------------------------------------
# Semantic chunker with per-corpus extra_meta_keys
# ---------------------------------------------------------------------------

def semantic_chunk_sections(
    section_docs: List[Document],
    embeddings,
    extra_meta_keys: Tuple[str, ...] = (),
) -> List[Document]:
    """
    Split each section into semantic chunks using SemanticChunker.

    Keys listed in extra_meta_keys are propagated from the section's metadata
    onto each child chunk as parent_<key>. Keys absent from a section are
    silently skipped — corpora that don't define these fields are unaffected.

    This replaces the module-level _PROPAGATED_SECTION_META tuple in the live
    chunker.py with a per-corpus, per-call parameter so different corpora can
    propagate different metadata without a shared global.
    """
    chunker = SemanticChunker(embeddings, breakpoint_threshold_type="percentile")
    chunks: List[Document] = []
    for sec in section_docs:
        try:
            parts = chunker.split_text(sec.page_content)
        except Exception as exc:
            logger.warning(
                "SemanticChunker failed on section %r — using section body as single chunk: %s",
                sec.metadata.get("section_id"), exc,
            )
            parts = [sec.page_content]
        if not parts:
            parts = [sec.page_content]
        for i, body in enumerate(parts):
            chunk_id = f"{sec.metadata['section_id']}::chunk_{i}"
            meta = {
                "parent_doc_name": sec.metadata["doc_name"],
                "parent_section_name": sec.metadata["section_name"],
                "parent_section_id": sec.metadata["section_id"],
                "chunk_id": chunk_id,
            }
            for key in extra_meta_keys:
                if key in sec.metadata:
                    meta[f"parent_{key}"] = sec.metadata[key]
            chunks.append(Document(page_content=body, metadata=meta))
    return chunks


# ---------------------------------------------------------------------------
# Public API
# ---------------------------------------------------------------------------

def build_corpus(
    corpus_cfg: CorpusConfig,
    force: bool = False,
    embedding_model: Optional[str] = None,
) -> Tuple[List[Document], List[Document]]:
    """
    End-to-end: raw files -> md -> sections -> semantic chunks -> persisted JSONL.

    Returns (chunks, sections). When force=False and persisted JSONL already
    exists under corpus_cfg.chunked_dir, returns those without re-chunking.

    Pass force=True whenever:
    - The splitter function or its regex changed.
    - extra_meta_keys changed (new fields to propagate).
    - Source files were replaced or added.
    """
    if not force:
        existing = load_persisted(corpus_cfg.chunked_dir)
        if existing is not None:
            logger.info(
                "[corpus=%r] Loaded %d chunks, %d sections from cache (%s).",
                corpus_cfg.name, len(existing[0]), len(existing[1]), corpus_cfg.chunked_dir,
            )
            return existing

    md_paths = _convert_all_raw(corpus_cfg, force=force)

    if not md_paths:
        logger.warning(
            "[corpus=%r] No source files found — returning empty corpus. "
            "Drop files under %s.",
            corpus_cfg.name, corpus_cfg.raw_dir,
        )
        corpus_cfg.chunked_dir.mkdir(parents=True, exist_ok=True)
        return [], []

