def load_or_build(
    corpus_cfg: CorpusConfig,
    force: bool = False,
    embedding_model: Optional[str] = None,
) -> Tuple[List[Document], List[Document]]:
    """
    Idempotent entry point: load cached JSONL if present, build otherwise.

    Alias for build_corpus that reads naturally at call sites:
        chunks, sections = load_or_build(design_cfg)
    """
    return build_corpus(corpus_cfg, force=force, embedding_model=embedding_model)
