"""
Node hierarchy for a LangGraph fan-out workflow.

Three layers, each adds one responsibility:

  BaseLLMNode (ABC)
    - Holds client/model/system_prompt/model_kwargs.
    - Static helpers: JSON-from-markdown extraction + multi-choice parse.

  StandardLLMNode (BaseLLMNode, ABC)
    - The async __call__ skeleton: validate -> build prompt -> call LLM ->
      parse -> inject metadata -> format response.
    - Subclasses implement:
        _build_prompt_and_meta(task) -> (user_prompt, meta_dict)
        _format_response(parsed)     -> {state_key: [parsed]}

  _EvalNodeBase (StandardLLMNode)
    - Holds retriever + jinja_env.
    - Default _format_response = {self.state_key: [parsed]}.

  ConcreteNode (_EvalNodeBase)
    - Sets `prompt_template` and `state_key` class attrs.
    - Implements `_build_prompt_and_meta` (10 lines: retrieve, render, return).

Adding a new evaluator dimension = a new ~10-line ConcreteNode subclass + a Jinja file.
"""
from __future__ import annotations

import json
import re
from abc import ABC, abstractmethod
from pathlib import Path
from typing import Any, List, Optional

from jinja2 import Environment, FileSystemLoader, select_autoescape
from langgraph.types import Send
from openai import AsyncOpenAI

