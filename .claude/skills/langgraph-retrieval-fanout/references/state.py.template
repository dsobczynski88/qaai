"""
State + result schema for a LangGraph fan-out workflow.

Rename:
  - Input              -> the per-item input model (Comment, Question, Document, ...)
  - Result1/2/3        -> one Pydantic model per parallel evaluator node
  - WorkflowState      -> your TypedDict state name
  - inputs / results_* -> match your domain (comments / critiques / ...)
  - EvalTask           -> the per-Send payload (rarely needs renaming)

Three load-bearing rules in this file:
  1. Every result model carries `retrieved_chunk_ids: List[str]` for traceability.
  2. Every parallel result list in WorkflowState is `Annotated[List[T], operator.add]`.
     Without operator.add, parallel Sends overwrite each other.
  3. EvalTask is intentionally minimal — just the per-item payload. Nodes get
     the retriever / jinja env via closures, not via state.
"""
from __future__ import annotations

import operator
from typing import Annotated, List, Literal, Optional, TypedDict

from pydantic import BaseModel, Field


# --- Input model ---

class Input(BaseModel):  # TODO(rename): e.g. Comment, Question, ReviewItem
    """One unit of work. The graph fans `List[Input]` out to N evaluator nodes."""
    item_id: int  # TODO(rename): comment_id, question_id, ...
    body: str
    # TODO(add): whatever fields your nodes need to build queries / filters
    # e.g.  doc_id: str
    #       section_label: Optional[str] = None
    #       category: Literal["a", "b", "c"]


# --- Result models (one per evaluator node) ---

class Result1(BaseModel):  # TODO(rename): Critique, Score, Summary, ...
    """First evaluator's typed output."""
    item_id: int
    # TODO(add): your dimension-specific fields, e.g.
    # has_issue: bool
    # findings: List[str] = Field(default_factory=list)
    # rationale: str
    retrieved_chunk_ids: List[str] = Field(
        default_factory=list,
        description="chunk_ids that contributed to this result; empty if retrieval missed.",
    )


class Result2(BaseModel):  # TODO(rename)
    item_id: int
    # TODO(add)
    retrieved_chunk_ids: List[str] = Field(default_factory=list)


class Result3(BaseModel):  # TODO(rename)
    item_id: int
    # TODO(add)
    retrieved_chunk_ids: List[str] = Field(default_factory=list)


# --- Top-level state ---

class WorkflowState(TypedDict):  # TODO(rename)
    inputs: List[Input]
    # operator.add merges {"results_1": [r]} dicts returned by parallel Sends.
    results_1: Annotated[List[Result1], operator.add]  # TODO(rename key + type)
    results_2: Annotated[List[Result2], operator.add]
    results_3: Annotated[List[Result3], operator.add]


# --- Per-Send payload ---

class EvalTask(TypedDict):
    """What each Send carries to a node. Keep minimal."""
    item: Input
