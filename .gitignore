.vscode/
output/

# Config files
config.yaml

# Output files
*.xlsx

# docs

# shared (reviewer cache; CACHE_DIR default ./shared)
shared/*
!/shared/.gitkeep

# pyjama JAMA test-mode source data (local-only, pyjama-owned path)
cache/

# data
data/*
!/data/.gitkeep

# local datasets
tests/fixtures/local/*
!/tests/fixtures/local/.gitkeep

# generated datasets
tests/fixtures/generated/*
!tests/fixtures/generated/.gitkeep

# mlflow
tests/fixtures/mlflow/*
!tests/fixtures/mlflow/.gitkeep
mlflow.db
mlruns/
eval/datasets/test_suite/*
!eval/datasets/test_suite/.gitkeep
# The committed RTM pilot (answer key), revision 1, at actual/<ts>/.
# Git will not descend into an excluded directory, so each level has to be re-included
# before its children can be allowlisted - hence the alternating !dir/ , dir/* pairs.
# The timestamp is named explicitly rather than re-including actual/ wholesale: every
# other revision under it is an unreviewed working set and must stay out of the repo.
!eval/datasets/test_suite/actual/
eval/datasets/test_suite/actual/*
!eval/datasets/test_suite/actual/2026-07-17_12-01-00/
eval/datasets/test_suite/actual/2026-07-17_12-01-00/*
!eval/datasets/test_suite/actual/2026-07-17_12-01-00/actual_inputs.jsonl
!eval/datasets/test_suite/actual/2026-07-17_12-01-00/actual_outputs.jsonl
!eval/datasets/test_suite/actual/2026-07-17_12-01-00/actual_labels.jsonl
!eval/datasets/test_suite/actual/2026-07-17_12-01-00/source_gold.jsonl
!eval/datasets/test_suite/actual/2026-07-17_12-01-00/description.md
!eval/datasets/test_suite/actual/2026-07-17_12-01-00/edits.log
eval/datasets/test_case/*
!eval/datasets/test_case/.gitkeep
# The committed test_case pilot (answer key, human-grounded 20-row seed), at actual/<ts>/.
# Same alternating !dir/ , dir/* re-inclusion pattern as the RTM pilot above. The timestamp
# is named explicitly so the 400-row calibration set and any other revision stay out of the repo.
!eval/datasets/test_case/actual/
eval/datasets/test_case/actual/*
!eval/datasets/test_case/actual/2026-07-21_08-29-19/
eval/datasets/test_case/actual/2026-07-21_08-29-19/*
!eval/datasets/test_case/actual/2026-07-21_08-29-19/actual_inputs.jsonl
!eval/datasets/test_case/actual/2026-07-21_08-29-19/actual_outputs.jsonl
!eval/datasets/test_case/actual/2026-07-21_08-29-19/actual_labels.jsonl
!eval/datasets/test_case/actual/2026-07-21_08-29-19/description.md
!eval/datasets/test_case/actual/2026-07-21_08-29-19/edits.log
eval/datasets/hazard/*
!eval/datasets/hazard/.gitkeep
!eval/datasets/hazard/actual/
eval/datasets/hazard/actual/*
!eval/datasets/hazard/actual/2026-07-21_08-11-24/
eval/datasets/hazard/actual/2026-07-21_08-11-24/*
!eval/datasets/hazard/actual/2026-07-21_08-11-24/actual_inputs.jsonl
!eval/datasets/hazard/actual/2026-07-21_08-11-24/actual_outputs.jsonl
!eval/datasets/hazard/actual/2026-07-21_08-11-24/actual_labels.jsonl
!eval/datasets/hazard/actual/2026-07-21_08-11-24/description.md
!eval/datasets/hazard/actual/2026-07-21_08-11-24/edits.log


# logs
logs/*
!/logs/.gitkeep

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
cover/

# Translations
*.mo
*.pot

# Django stuff:
*.log
# ...but a dataset's edits.log is its audit trail, not a runtime log: it is the record of
# who changed which label and why. This negation sits after *.log because the last
# matching pattern wins, so re-including it earlier (with the pilot allowlist) would not.
!eval/datasets/**/edits.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to ignore these files since the code is
#   intended to run in multiple environments; otherwise, check them in:
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having no cross-platform support, pipenv may install dependencies that don't work, or not
#   install all needed dependencies.
#Pipfile.lock

# UV
#   Similar to Pipfile.lock, it is generally recommended to include uv.lock in version control.
#   This is especially recommended for binary packages to ensure reproducibility, and is more
#   commonly ignored for libraries.
#uv.lock

# poetry
#   Similar to Pipfile.lock, it is generally recommended to include poetry.lock in version control.
#   This is especially recommended for binary packages to ensure reproducibility, and is more
#   commonly ignored for libraries.
#   https://python-poetry.org/docs/basic-usage/#commit-your-poetrylock-file-to-version-control
#poetry.lock
#poetry.toml

# pdm
#   Similar to Pipfile.lock, it is generally recommended to include pdm.lock in version control.
#   pdm recommends including project-wide configuration in pdm.toml, but excluding .pdm-python.
#   https://pdm-project.org/en/latest/usage/project/#working-with-version-control
#pdm.lock
#pdm.toml
.pdm-python
.pdm-build/

# pixi
#   Similar to Pipfile.lock, it is generally recommended to include pixi.lock in version control.
#pixi.lock
#   Pixi creates a virtual environment in the .pixi directory, just like venv module creates one
#   in the .venv directory. It is recommended not to include this directory in version control.
.pixi

# PEP 582; used by e.g. github.com/David-OConnor/pyflow and github.com/pdm-project/pdm
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

